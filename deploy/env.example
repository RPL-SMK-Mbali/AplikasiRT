# ============================================================
# KAS RT ONLINE — Contoh file .env (mode MySQL)
# Salin sebagai ".env" di folder utama proyek, lalu sesuaikan.
# ============================================================

# Format: mysql://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
# >>> GANTI "GANTI_PASSWORD" dengan password MySQL Anda <<<
DATABASE_URL="mysql://kasrt:GANTI_PASSWORD@127.0.0.1:3306/kas_rt"

# CATATAN PENTING:
# 1. Jika password mengandung karakter khusus (@ : / # ? dll),
#    gunakan URL-encode. Contoh: @ menjadi %40, # menjadi %23.
# 2. Port default MySQL 3306; XAMPP/WAMP di Windows kadang memakai
#    3306 juga, tapi kalau bentrok bisa jadi 3307 — sesuaikan.
# 3. Setelah mengubah file ini, jalankan ulang:
#       npx prisma generate
#       npx prisma db push
